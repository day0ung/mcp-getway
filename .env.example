# ── Jira / Confluence (Atlassian Cloud) ──
JIRA_BASE_URL=https://{domain}.atlassian.net
JIRA_EMAIL=youemail@gail.co.kr
JIRA_API_TOKEN=your_api_token_here

# (선택) Confluence 인스턴스가 Jira와 다를 때만 지정
# CONFLUENCE_BASE_URL=
# CONFLUENCE_EMAIL=
# CONFLUENCE_API_TOKEN=

# ── GitLab ──
# 자체호스팅 예: https://gitlab.사내.co.kr   (끝의 /api/v4 붙이지 말 것)
# SaaS 예:      https://gitlab.com
GITLAB_BASE_URL=https://gitlab.com
# Personal Access Token (필요 scope: api)
GITLAB_TOKEN=your_gitlab_personal_access_token_here

# ── Notion ──
# Internal Integration Token (https://www.notion.so/profile/integrations 에서 발급)
# 사용할 페이지/DB에 해당 integration을 Connections로 추가해야 권한이 생긴다.
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── PostgreSQL ──
# DB 연결 정보(host/user/password 등)는 .env가 아니라 postgres.databases.json 파일에서 관리한다.
# postgres.databases.example.json을 postgres.databases.json으로 복사해 채울 것.
# 반드시 읽기 전용(SELECT만 가능) 계정을 사용할 것.
#
# 파일 경로를 바꾸고 싶을 때만 지정 (기본: 실행 디렉터리의 postgres.databases.json)
# POSTGRES_CONFIG_FILE=postgres.databases.json
